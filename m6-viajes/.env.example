# Copiar a .env y ajustar. Nunca subir .env al repositorio (RNF-06).

PUERTO=3000

# Formato de los logs: "texto" (legible al programar) o "json" (estructurado, el de producción).
LOG_FORMATO=texto

# Secreto para verificar los JWT. Mientras M1 no emita tokens, `npm run token` firma tokens de
# desarrollo con este mismo valor. En cualquier entorno compartido usar un valor propio y largo.
JWT_SECRETO=secreto-de-desarrollo-cambiar-en-entornos-compartidos
# Opcionales: si se definen, el token debe traer ese emisor (iss) y esa audiencia (aud).
# JWT_EMISOR=m1-identidad
# JWT_AUDIENCIA=movilidad

# Límite de pedidos por minuto y por usuario (0 = sin límite). Los servicios (M5, M2) tienen uno propio.
LIMITE_PEDIDOS_POR_MINUTO=120
LIMITE_PEDIDOS_SERVICIO_POR_MINUTO=1200

# Orígenes web que pueden llamar a la API desde un navegador, separados por coma (vacío = ninguno).
# CORS_ORIGENES=http://localhost:5173

# Infraestructura local: `npm run infra:levantar` levanta PostgreSQL, RabbitMQ y Redis.

# Dónde se guardan los viajes: "postgres" o "memoria" (sin base; los datos se pierden al reiniciar).
PERSISTENCIA=postgres
BASE_DATOS_URL=postgres://m6:m6@localhost:5432/m6_viajes

# Adónde van los eventos: "rabbitmq" o "log" (se muestran en la terminal, sin broker).
PUBLICADOR_EVENTOS=rabbitmq
RABBITMQ_URL=amqp://m6:m6@localhost:5672

# Dónde se guardan las Idempotency-Key y los contadores del límite de pedidos:
# "redis" o "memoria" (se pierden al reiniciar y no se comparten entre instancias).
IDEMPOTENCIA=redis
REDIS_URL=redis://localhost:6379

# Cada cuántos ms el relevador revisa la bandeja de salida de eventos.
OUTBOX_INTERVALO_MS=1000

# Minutos que el conductor espera tras el arribo antes de cancelar por CLIENTE_NO_SE_PRESENTO.
ESPERA_MINIMA_ARRIBO_MINUTOS=5

# Validación del QR: "simulado" (el código válido es QR-<viajeId>) o "m8" (llama a M8 por HTTP).
VALIDADOR_QR=simulado
# Con VALIDADOR_QR=m8 se consulta en paralelo a los M8 de M8_PROVEEDORES (el QR lo genera uno
# solo de ellos). Valores: g7, g10 o g7,g10.
# M8_PROVEEDORES=g7,g10
# M8_TIMEOUT_MS=2000
# Los dos M8 comparten contrato: POST /api/v1/qr/validaciones { token, viajeId } (valor por defecto).
# Los tokens de servicio para M8 deben llevar el rol SERVICIO (el G10 rechaza SYSTEM con 403).
# Grupo 7 (.NET, puerto 8088). Su código actual todavía valida en /api/Documentos/qr/validar:
# usar M8_G7_RUTA_QR hasta que lo alineen.
# M8_G7_URL=http://localhost:8088
# M8_G7_RUTA_QR=/api/Documentos/qr/validar
# M8_G7_TOKEN=<JWT de servicio emitido por M1>
# Grupo 10 (NestJS). Ya implementa la ruta del contrato en su rama develop.
# M8_G10_URL=http://localhost:3008
# M8_G10_TOKEN=<JWT de servicio emitido por M1>

# Tarifa final en M7: "ninguno" (no avisa a M7) o "m7" (al completar el viaje llama a
# POST /api/v1/tarifas/viajes/{viaje_id}/tarifa-final del contrato común de M7, Grupos 6 y 11).
# Se configura un solo M7: registrar en los dos duplicaría el cobro. Si M7 falla, el viaje igual
# queda completado y el error queda en el log.
REGISTRO_TARIFA=ninguno
# M7_URL=http://localhost:8000
# M7_TIMEOUT_MS=2000
# M7 exige el scope tarifas:write (todavía no está en el realm de Keycloak de la cátedra).
# M7_TOKEN=<JWT de servicio emitido por M1>
